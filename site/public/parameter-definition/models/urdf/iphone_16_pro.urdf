<?xml version="1.0"?>
<!-- iPhone 16 Pro: generated by imuninn from Apple's dimensional drawings (iphone-frames dataset). Frames: device = display centre on the front glass (x right, y top, z out of the screen); cam_*_optical = OpenCV axes. Geometry and mass are approximate. -->
<robot name="iphone_16_pro">
  <material name="iphone_body">
    <color rgba="0.15 0.15 0.17 1" />
  </material>
  <material name="iphone_lens">
    <color rgba="0.05 0.05 0.06 1" />
  </material>
  <link name="device">
    <visual name="body">
      <origin xyz="7.10542736e-18 -1.42108547e-17 -0.004125" rpy="0 0 0" />
      <geometry>
        <box size="0.07145 0.14961 0.00825" />
      </geometry>
      <material name="iphone_body" />
    </visual>
    <collision name="body">
      <origin xyz="7.10542736e-18 -1.42108547e-17 -0.004125" rpy="0 0 0" />
      <geometry>
        <box size="0.07145 0.14961 0.00825" />
      </geometry>
    </collision>
    <visual name="lens_ultra_wide">
      <origin xyz="0.021555 0.060635 -0.01039" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0081" length="0.00428" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <visual name="lens_main">
      <origin xyz="0.021555 0.041395 -0.01039" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0081" length="0.00428" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <visual name="lens_telephoto">
      <origin xyz="0.003545 0.051015 -0.01039" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0081" length="0.00428" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <inertial>
      <origin xyz="7.10542736e-18 -1.42108547e-17 -0.004125" rpy="0 0 0" />
      <mass value="0.203" />
      <inertia ixx="0.0003798" ixy="0" ixz="0" iyy="8.75127e-05" iyz="0" izz="0.00046501" />
    </inertial>
  </link>
  <link name="magsafe" />
  <joint name="device_to_magsafe" type="fixed">
    <parent link="device" />
    <child link="magsafe" />
    <origin xyz="5e-06 -0.000245 -0.00825" rpy="3.14159265 0 3.14159265" />
  </joint>
  <link name="cam_ultra_wide_optical" />
  <joint name="device_to_cam_ultra_wide_optical" type="fixed">
    <parent link="device" />
    <child link="cam_ultra_wide_optical" />
    <origin xyz="0.021555 0.060635 -0.01253" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_main_optical" />
  <joint name="device_to_cam_main_optical" type="fixed">
    <parent link="device" />
    <child link="cam_main_optical" />
    <origin xyz="0.021555 0.041395 -0.01253" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_telephoto_optical" />
  <joint name="device_to_cam_telephoto_optical" type="fixed">
    <parent link="device" />
    <child link="cam_telephoto_optical" />
    <origin xyz="0.003545 0.051015 -0.01253" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_front_optical" />
  <joint name="device_to_cam_front_optical" type="fixed">
    <parent link="device" />
    <child link="cam_front_optical" />
    <origin xyz="0.007315 0.067015 0" rpy="0 0 1.57079633" />
  </joint>
  <link name="imu" />
  <joint name="device_to_imu" type="fixed">
    <parent link="device" />
    <child link="imu" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>
