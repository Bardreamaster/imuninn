<?xml version="1.0"?>
<!-- iPhone 17: generated by imuninn from Apple's dimensional drawings (iphone-frames dataset). Frames: device = display centre on the front glass (x right, y top, z out of the screen); cam_*_optical = OpenCV axes. Geometry and mass are approximate. -->
<robot name="iphone_17">
  <material name="iphone_body">
    <color rgba="0.15 0.15 0.17 1" />
  </material>
  <material name="iphone_lens">
    <color rgba="0.05 0.05 0.06 1" />
  </material>
  <link name="device">
    <visual name="body">
      <origin xyz="7.10542736e-18 -1.42108547e-17 -0.003975" rpy="0 0 0" />
      <geometry>
        <box size="0.07145 0.14961 0.00795" />
      </geometry>
      <material name="iphone_body" />
    </visual>
    <collision name="body">
      <origin xyz="7.10542736e-18 -1.42108547e-17 -0.003975" rpy="0 0 0" />
      <geometry>
        <box size="0.07145 0.14961 0.00795" />
      </geometry>
    </collision>
    <visual name="lens_ultra_wide">
      <origin xyz="0.022105 0.061185 -0.009675" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.008" length="0.00345" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <visual name="lens_main">
      <origin xyz="0.022105 0.043465 -0.009675" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.008" length="0.00345" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <inertial>
      <origin xyz="7.10542736e-18 -1.42108547e-17 -0.003975" rpy="0 0 0" />
      <mass value="0.195" />
      <inertia ixx="0.000364753" ixy="0" ixz="0" iyy="8.3985e-05" iyz="0" izz="0.000446684" />
    </inertial>
  </link>
  <link name="magsafe" />
  <joint name="device_to_magsafe" type="fixed">
    <parent link="device" />
    <child link="magsafe" />
    <origin xyz="5e-06 -5e-06 -0.00795" rpy="3.14159265 0 3.14159265" />
  </joint>
  <link name="cam_ultra_wide_optical" />
  <joint name="device_to_cam_ultra_wide_optical" type="fixed">
    <parent link="device" />
    <child link="cam_ultra_wide_optical" />
    <origin xyz="0.022105 0.061185 -0.0114" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_main_optical" />
  <joint name="device_to_cam_main_optical" type="fixed">
    <parent link="device" />
    <child link="cam_main_optical" />
    <origin xyz="0.022105 0.043465 -0.0114" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_front_optical" />
  <joint name="device_to_cam_front_optical" type="fixed">
    <parent link="device" />
    <child link="cam_front_optical" />
    <origin xyz="0.007825 0.067015 0" rpy="0 0 -1.57079633" />
  </joint>
  <link name="imu" />
  <joint name="device_to_imu" type="fixed">
    <parent link="device" />
    <child link="imu" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>
