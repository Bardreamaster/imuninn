<?xml version="1.0"?>
<!-- iPhone SE (3rd generation): generated by imuninn from Apple's dimensional drawings (iphone-frames dataset). Frames: device = display centre on the front glass (x right, y top, z out of the screen); cam_*_optical = OpenCV axes. Geometry and mass are approximate. -->
<robot name="iphone_se_3rd_generation">
  <material name="iphone_body">
    <color rgba="0.15 0.15 0.17 1" />
  </material>
  <material name="iphone_lens">
    <color rgba="0.05 0.05 0.06 1" />
  </material>
  <link name="device">
    <visual name="body">
      <origin xyz="5e-06 -5e-06 -0.003655" rpy="0 0 0" />
      <geometry>
        <box size="0.06727 0.13844 0.00731" />
      </geometry>
      <material name="iphone_body" />
    </visual>
    <collision name="body">
      <origin xyz="5e-06 -5e-06 -0.003655" rpy="0 0 0" />
      <geometry>
        <box size="0.06727 0.13844 0.00731" />
      </geometry>
    </collision>
    <visual name="lens_main">
      <origin xyz="0.0232 0.058975 -0.007745" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.004285" length="0.00087" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <inertial>
      <origin xyz="5e-06 -5e-06 -0.003655" rpy="0 0 0" />
      <mass value="0.157" />
      <inertia ixx="0.000251449" ixy="0" ixz="0" iyy="5.99045e-05" iyz="0" izz="0.000309956" />
    </inertial>
  </link>
  <link name="magsafe" />
  <joint name="device_to_magsafe" type="fixed">
    <parent link="device" />
    <child link="magsafe" />
    <origin xyz="1e-05 -5e-06 -0.00731" rpy="3.14159265 0 3.14159265" />
  </joint>
  <link name="cam_main_optical" />
  <joint name="device_to_cam_main_optical" type="fixed">
    <parent link="device" />
    <child link="cam_main_optical" />
    <origin xyz="0.0232 0.058975 -0.00818" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_front_optical" />
  <joint name="device_to_cam_front_optical" type="fixed">
    <parent link="device" />
    <child link="cam_front_optical" />
    <origin xyz="-0.01064 0.060055 0" rpy="0 0 1.57079633" />
  </joint>
  <link name="imu" />
  <joint name="device_to_imu" type="fixed">
    <parent link="device" />
    <child link="imu" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>
