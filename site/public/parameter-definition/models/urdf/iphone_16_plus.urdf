<?xml version="1.0"?>
<!-- iPhone 16 Plus: generated by imuninn from Apple's dimensional drawings (iphone-frames dataset). Frames: device = display centre on the front glass (x right, y top, z out of the screen); cam_*_optical = OpenCV axes. Geometry and mass are approximate. -->
<robot name="iphone_16_plus">
  <material name="iphone_body">
    <color rgba="0.15 0.15 0.17 1" />
  </material>
  <material name="iphone_lens">
    <color rgba="0.05 0.05 0.06 1" />
  </material>
  <link name="device">
    <visual name="body">
      <origin xyz="5e-06 0 -0.003905" rpy="0 0 0" />
      <geometry>
        <box size="0.07776 0.16088 0.00781" />
      </geometry>
      <material name="iphone_body" />
    </visual>
    <collision name="body">
      <origin xyz="5e-06 0 -0.003905" rpy="0 0 0" />
      <geometry>
        <box size="0.07776 0.16088 0.00781" />
      </geometry>
    </collision>
    <visual name="lens_ultra_wide">
      <origin xyz="0.025265 0.06682 -0.00955" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.008" length="0.00348" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <visual name="lens_main">
      <origin xyz="0.025265 0.0491 -0.00955" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.008" length="0.00348" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <inertial>
      <origin xyz="5e-06 0 -0.003905" rpy="0 0 0" />
      <mass value="0.225" />
      <inertia ixx="0.000486438" ixy="0" ixz="0" iyy="0.000114518" iyz="0" izz="0.000598669" />
    </inertial>
  </link>
  <link name="magsafe" />
  <joint name="device_to_magsafe" type="fixed">
    <parent link="device" />
    <child link="magsafe" />
    <origin xyz="5e-06 0 -0.00781" rpy="3.14159265 0 3.14159265" />
  </joint>
  <link name="cam_ultra_wide_optical" />
  <joint name="device_to_cam_ultra_wide_optical" type="fixed">
    <parent link="device" />
    <child link="cam_ultra_wide_optical" />
    <origin xyz="0.025265 0.06682 -0.01129" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_main_optical" />
  <joint name="device_to_cam_main_optical" type="fixed">
    <parent link="device" />
    <child link="cam_main_optical" />
    <origin xyz="0.025265 0.0491 -0.01129" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_front_optical" />
  <joint name="device_to_cam_front_optical" type="fixed">
    <parent link="device" />
    <child link="cam_front_optical" />
    <origin xyz="0.007705 0.07226 0" rpy="0 0 1.57079633" />
  </joint>
  <link name="imu" />
  <joint name="device_to_imu" type="fixed">
    <parent link="device" />
    <child link="imu" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>
