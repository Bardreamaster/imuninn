<?xml version="1.0"?>
<!-- iPhone 12: generated by imuninn from Apple's dimensional drawings (iphone-frames dataset). Frames: device = display centre on the front glass (x right, y top, z out of the screen); cam_*_optical = OpenCV axes. Geometry and mass are approximate. -->
<robot name="iphone_12">
  <material name="iphone_body">
    <color rgba="0.15 0.15 0.17 1" />
  </material>
  <material name="iphone_lens">
    <color rgba="0.05 0.05 0.06 1" />
  </material>
  <link name="device">
    <visual name="body">
      <origin xyz="0 0 -0.003695" rpy="0 0 0" />
      <geometry>
        <box size="0.07152 0.14671 0.00739" />
      </geometry>
      <material name="iphone_body" />
    </visual>
    <collision name="body">
      <origin xyz="0 0 -0.003695" rpy="0 0 0" />
      <geometry>
        <box size="0.07152 0.14671 0.00739" />
      </geometry>
    </collision>
    <visual name="lens_ultra_wide">
      <origin xyz="0.02303 0.060625 -0.008145" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.00605" length="0.00151" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <visual name="lens_main">
      <origin xyz="0.02303 0.046345 -0.008145" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.00605" length="0.00151" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <inertial>
      <origin xyz="0 0 -0.003695" rpy="0 0 0" />
      <mass value="0.178" />
      <inertia ixx="0.00032008" ixy="0" ixz="0" iyy="7.66842e-05" iyz="0" izz="0.000395144" />
    </inertial>
  </link>
  <link name="magsafe" />
  <joint name="device_to_magsafe" type="fixed">
    <parent link="device" />
    <child link="magsafe" />
    <origin xyz="0 5e-06 -0.00739" rpy="3.14159265 0 3.14159265" />
  </joint>
  <link name="cam_ultra_wide_optical" />
  <joint name="device_to_cam_ultra_wide_optical" type="fixed">
    <parent link="device" />
    <child link="cam_ultra_wide_optical" />
    <origin xyz="0.02303 0.060625 -0.0089" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_main_optical" />
  <joint name="device_to_cam_main_optical" type="fixed">
    <parent link="device" />
    <child link="cam_main_optical" />
    <origin xyz="0.02303 0.046345 -0.0089" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_front_optical" />
  <joint name="device_to_cam_front_optical" type="fixed">
    <parent link="device" />
    <child link="cam_front_optical" />
    <origin xyz="0 0.067885 0" rpy="0 0 1.57079633" />
  </joint>
  <link name="imu" />
  <joint name="device_to_imu" type="fixed">
    <parent link="device" />
    <child link="imu" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>
