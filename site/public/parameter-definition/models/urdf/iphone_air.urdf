<?xml version="1.0"?>
<!-- iPhone Air: generated by imuninn from Apple's dimensional drawings (iphone-frames dataset). Frames: device = display centre on the front glass (x right, y top, z out of the screen); cam_*_optical = OpenCV axes. Geometry and mass are approximate. -->
<robot name="iphone_air">
  <material name="iphone_body">
    <color rgba="0.15 0.15 0.17 1" />
  </material>
  <material name="iphone_lens">
    <color rgba="0.05 0.05 0.06 1" />
  </material>
  <link name="device">
    <visual name="body">
      <origin xyz="-5e-06 5e-06 -0.00282" rpy="0 0 0" />
      <geometry>
        <box size="0.0747 0.15618 0.00564" />
      </geometry>
      <material name="iphone_body" />
    </visual>
    <collision name="body">
      <origin xyz="-5e-06 5e-06 -0.00282" rpy="0 0 0" />
      <geometry>
        <box size="0.0747 0.15618 0.00564" />
      </geometry>
    </collision>
    <visual name="lens_main">
      <origin xyz="0.021055 0.061805 -0.00848" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.00791" length="0.00568" />
      </geometry>
      <material name="iphone_lens" />
    </visual>
    <inertial>
      <origin xyz="-5e-06 5e-06 -0.00282" rpy="0 0 0" />
      <mass value="0.151" />
      <inertia ixx="0.000307335" ixy="0" ixz="0" iyy="7.06164e-05" iyz="0" izz="0.000377151" />
    </inertial>
  </link>
  <link name="magsafe" />
  <joint name="device_to_magsafe" type="fixed">
    <parent link="device" />
    <child link="magsafe" />
    <origin xyz="-5e-06 -0.000245 -0.00564" rpy="3.14159265 0 3.14159265" />
  </joint>
  <link name="cam_main_optical" />
  <joint name="device_to_cam_main_optical" type="fixed">
    <parent link="device" />
    <child link="cam_main_optical" />
    <origin xyz="0.021055 0.061805 -0.01132" rpy="3.14159265 0 -1.57079633" />
  </joint>
  <link name="cam_front_optical" />
  <joint name="device_to_cam_front_optical" type="fixed">
    <parent link="device" />
    <child link="cam_front_optical" />
    <origin xyz="0.007315 0.069165 0" rpy="0 0 -1.57079633" />
  </joint>
  <link name="imu" />
  <joint name="device_to_imu" type="fixed">
    <parent link="device" />
    <child link="imu" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>
